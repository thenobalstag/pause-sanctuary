function Games({go}){
 const[game,setGame]=useState("bubbles"),[bubbles,setBubbles]=useState([]),[stars,setStars]=useState([]);

 useEffect(()=>{
  if(game!=="bubbles")return;
  const id=setInterval(()=>setBubbles(x=>[
   ...x.slice(-12),
   {id:Date.now(),left:Math.random()*85,size:40+Math.random()*55}
  ]),1500);
  return()=>clearInterval(id);
 },[game]);

 const addStar=e=>{
  if(e.target.closest("button"))return;
  const r=e.currentTarget.getBoundingClientRect();
  const x=((e.clientX-r.left)/r.width)*100;
  const y=((e.clientY-r.top)/r.height)*100;
  setStars(prev=>[...prev,{x,y,id:Date.now()+Math.random()}]);
 };

 const connectionDistance=24;
 const constellationLines=[];

 stars.forEach((star,i)=>{
  stars.slice(i+1).forEach(other=>{
   const dx=star.x-other.x;
   const dy=star.y-other.y;
   const distance=Math.sqrt(dx*dx+dy*dy);

   if(distance<=connectionDistance){
    constellationLines.push({
     a:star,
     b:other,
     key:"line-"+star.id+"-"+other.id
    });
   }
  });
 });

 return <div className="page">
  <Nav go={go}/>
  <main className="content narrow">
   <h1>Play Without Winning</h1>
   <p className="sub">Games that don't ask you to win.</p>

   <div className="tabs">
    {["bubbles","sky"].map(x=>
     <button
      className={game===x?"active":""}
      onClick={()=>setGame(x)}
      key={x}
     >
      {x==="bubbles"?"Bubbles":"Night Sky"}
     </button>
    )}
   </div>

   <div className="gamebox">
    {game==="bubbles"&&bubbles.map(b=>
     <button
      className="bubble"
      key={b.id}
      style={{left:b.left+"%",width:b.size,height:b.size}}
      onClick={()=>setBubbles(x=>x.filter(q=>q.id!==b.id))}
     />
    )}

    {game==="bubbles"&&<p>Tap the bubbles. Let them go.</p>}

    {game==="sky"&&
     <div className="sky" onClick={addStar}>
      <svg
       className="constellation-lines"
       viewBox="0 0 100 100"
       preserveAspectRatio="none"
       aria-hidden="true"
      >
       {constellationLines.map(line=>
        <line
         key={line.key}
         x1={line.a.x}
         y1={line.a.y}
         x2={line.b.x}
         y2={line.b.y}
         className="constellation-line"
        />
       )}
      </svg>

      {stars.map(star=>
       <span
        key={star.id}
        className="star"
        style={{left:star.x+"%",top:star.y+"%"}}
       />
      )}

      {stars.length===0&&<p>Click anywhere to place a star.</p>}

      {stars.length>0&&
       <button
        className="clear-stars"
        onClick={e=>{
         e.stopPropagation();
         setStars([]);
        }}
       >
        Clear sky
       </button>
      }
     </div>
    }
   </div>
  </main>
  <Footer go={go}/>
 </div>
}
